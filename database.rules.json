{
  "rules": {
    "anki-sync": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['user_id', 'payload', 'updated_at']) && newData.child('user_id').val() === auth.uid && newData.child('payload').hasChild('cards')"
      }
    }
  }
}
